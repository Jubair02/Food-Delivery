# ── Server ──────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173
# Origin of the separate admin dashboard app
ADMIN_CLIENT_URL=http://localhost:5174

# ── Admin auth (separate realm from customers) ──────────
# Secret used to sign admin JWTs. Use a long random string.
ADMIN_JWT_SECRET=

# ── MongoDB ─────────────────────────────────────────────
# Paste your MongoDB connection string here. For MongoDB Atlas it looks like:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/food-delivery?retryWrites=true&w=majority
# For a local install:
#   mongodb://127.0.0.1:27017/food-delivery
MONGODB_URI=

# ── Firebase Admin (server-side token verification) ─────
# From Firebase console → Project settings → Service accounts → "Generate new private key".
# Either point to the downloaded JSON file...
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# ...OR paste the three fields directly (useful for hosting env vars).
# If you use these, the private key must keep its \n escapes on a single line.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Payments (Stripe) ───────────────────────────────────
# From the Stripe dashboard → Developers → API keys → "Secret key".
# Leave blank to run in cash-on-delivery mode (no online payment).
STRIPE_SECRET_KEY=

# ── Business rules ──────────────────────────────────────
DELIVERY_FEE=2
